package com.earthbound.buildings.usa.washington.skagit_county.guemes_island;

import com.earthbound.EarthCoordinates;
import com.earthbound.EarthElevation;
import com.earthbound.EarthTerrainLoader;

public class GuemesGeneralStore {

    /*
     * =====================================================
     * GUEMES ISLAND GENERAL STORE
     * =====================================================
     *
     * Real-world building data is stored using
     * latitude and longitude.
     *
     * Minecraft X/Z coordinates are calculated
     * from EarthBound's current horizontal scale.
     *
     * This means the store can be repositioned
     * automatically if EarthBound changes from
     * 1:2 to another scale later.
     */


    /*
     * Approximate real-world location.
     */
    public static final double LATITUDE =
            48.529460;

    public static final double LONGITUDE =
            -122.624110;


    /*
     * Playable Minecraft dimensions.
     *
     * EarthBound's geographic map is currently
     * 1:2, but buildings are allowed to remain
     * large enough for playable interiors.
     *
     * These dimensions can be adjusted later
     * when we refine the store from our
     * reference images.
     */
    public static final int WIDTH =
            24;

    public static final int LENGTH =
            16;


    /*
     * Small terrain preparation margin around
     * the building.
     *
     * We intentionally keep this small because
     * the store is close to the shoreline.
     */
    public static final int FOUNDATION_MARGIN =
            2;


    private GuemesGeneralStore() {
    }


    /*
     * Center Minecraft X coordinate.
     */
    public static int getCenterX() {

        return EarthCoordinates
                .longitudeToMinecraftX(
                        LONGITUDE
                );
    }


    /*
     * Center Minecraft Z coordinate.
     */
    public static int getCenterZ() {

        return EarthCoordinates
                .latitudeToMinecraftZ(
                        LATITUDE
                );
    }


    /*
     * Returns true when a Minecraft column
     * falls inside the store building itself.
     */
    public static boolean isInsideBuilding(
            int worldX,
            int worldZ) {

        int centerX =
                getCenterX();

        int centerZ =
                getCenterZ();

        int halfWidth =
                WIDTH / 2;

        int halfLength =
                LENGTH / 2;

        return worldX >= centerX - halfWidth
                && worldX <= centerX + halfWidth
                && worldZ >= centerZ - halfLength
                && worldZ <= centerZ + halfLength;
    }


    /*
     * Returns true when a Minecraft column
     * falls inside the terrain-preparation
     * area around the store.
     */
    public static boolean isInsideFoundationArea(
            int worldX,
            int worldZ) {

        int centerX =
                getCenterX();

        int centerZ =
                getCenterZ();

        int halfWidth =
                WIDTH / 2
                        + FOUNDATION_MARGIN;

        int halfLength =
                LENGTH / 2
                        + FOUNDATION_MARGIN;

        return worldX >= centerX - halfWidth
                && worldX <= centerX + halfWidth
                && worldZ >= centerZ - halfLength
                && worldZ <= centerZ + halfLength;
    }


    /*
     * Read the USGS terrain elevation at
     * the center of the General Store.
     *
     * EarthTerrainLoader already keeps the
     * Guemes elevation raster in memory.
     */
    public static Double getRealElevation() {

        return EarthTerrainLoader
                .getGuemesElevation(
                        LATITUDE,
                        LONGITUDE
                );
    }


    /*
     * Convert the real elevation into the
     * Minecraft Y level used by EarthBound.
     */
    public static int getGroundY() {

        Double elevation =
                getRealElevation();

        if (elevation == null
                || !Double.isFinite(elevation)) {

            return 63;
        }

        return EarthElevation
                .getMinecraftHeight(
                        elevation
                );
    }


    /*
     * Future entrance/spawn position.
     *
     * Once the actual store is constructed,
     * we'll adjust this to put the player
     * safely outside the front entrance.
     */
    public static int getEntranceX() {

        return getCenterX();
    }


    public static int getEntranceZ() {

        return getCenterZ()
                - (LENGTH / 2)
                - 2;
    }


    /*
     * Diagnostic information useful while
     * developing EarthBound.
     */
    public static String getLocationInfo() {

        return "Guemes General Store: "
                + "lat="
                + LATITUDE
                + ", lon="
                + LONGITUDE
                + ", x="
                + getCenterX()
                + ", z="
                + getCenterZ()
                + ", groundY="
                + getGroundY();
    }
}
