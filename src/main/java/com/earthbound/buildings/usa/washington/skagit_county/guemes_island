package com.earthbound.buildings.usa.washington.skagit_county.guemes_island;

import com.earthbound.EarthCoordinates;
import com.earthbound.EarthElevation;
import com.earthbound.EarthTerrainLoader;

public class GuemesGeneralStore {

    /*
     * =====================================================
     * GUEMES ISLAND GENERAL STORE
     * =====================================================
     *
     * Real-world building data is stored using
     * latitude and longitude.
     *
     * Minecraft X/Z coordinates are calculated
     * automatically from EarthBound's scale.
     */

    public static final double LATITUDE =
            48.529460;

    public static final double LONGITUDE =
            -122.624110;


    /*
     * Playable Minecraft building size.
     *
     * The map is 1:2 scale, but buildings
     * remain Minecraft-sized for gameplay.
     */

    public static final int WIDTH =
            24;

    public static final int LENGTH =
            16;


    /*
     * Small foundation area around the store.
     */
    public static final int FOUNDATION_MARGIN =
            2;


    private GuemesGeneralStore() {
    }


    /*
     * Center X position calculated from
     * real-world longitude.
     */
    public static int getCenterX() {

        return EarthCoordinates
                .longitudeToMinecraftX(
                        LONGITUDE
                );
    }


    /*
     * Center Z position calculated from
     * real-world latitude.
     */
    public static int getCenterZ() {

        return EarthCoordinates
                .latitudeToMinecraftZ(
                        LATITUDE
                );
    }


    /*
     * Checks if a location is inside the
     * actual store footprint.
     */
    public static boolean isInsideBuilding(
            int worldX,
            int worldZ) {

        int centerX =
                getCenterX();

        int centerZ =
                getCenterZ();

        int halfWidth =
                WIDTH / 2;

        int halfLength =
                LENGTH / 2;


        return worldX >= centerX - halfWidth
                && worldX <= centerX + halfWidth
                && worldZ >= centerZ - halfLength
                && worldZ <= centerZ + halfLength;
    }


    /*
     * Checks if a location is inside the
     * foundation preparation area.
     */
    public static boolean isInsideFoundationArea(
            int worldX,
            int worldZ) {

        int centerX =
                getCenterX();

        int centerZ =
                getCenterZ();


        int halfWidth =
                WIDTH / 2
                        + FOUNDATION_MARGIN;

        int halfLength =
                LENGTH / 2
                        + FOUNDATION_MARGIN;


        return worldX >= centerX - halfWidth
                && worldX <= centerX + halfWidth
                && worldZ >= centerZ - halfLength
                && worldZ <= centerZ + halfLength;
    }


    /*
     * Gets real elevation from the
     * EarthBound terrain data.
     */
    public static Double getRealElevation() {

        return EarthTerrainLoader
                .getGuemesElevation(
                        LATITUDE,
                        LONGITUDE
                );
    }


    /*
     * Converts real elevation into
     * Minecraft height.
     */
    public static int getGroundY() {

        Double elevation =
                getRealElevation();


        if (elevation == null
                || !Double.isFinite(
                        elevation
                )) {

            return 63;
        }


        return EarthElevation
                .getMinecraftHeight(
                        elevation
                );
    }


    /*
     * Future player spawn location.
     *
     * We will adjust this after the
     * actual entrance is built.
     */
    public static int getEntranceX() {

        return getCenterX();
    }


    public static int getEntranceZ() {

        return getCenterZ()
                - (LENGTH / 2)
                - 2;
    }


    /*
     * Debug information.
     */
    public static String getLocationInfo() {

        return "Guemes General Store: "
                + "lat="
                + LATITUDE
                + ", lon="
                + LONGITUDE
                + ", x="
                + getCenterX()
                + ", z="
                + getCenterZ()
                + ", groundY="
                + getGroundY();
    }
}
